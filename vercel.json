{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/(.*\\.(?:html|css|js|jpg|jpeg|png|gif|webp|ico|svg|txt))",
      "dest": "/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
